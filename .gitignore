/target
*.swp
*.swo
.DS_Store
.env
.env.local
*.log
dump.txt
wr.sh
warnings.txt
*.bak.*

# Stray binaries in docs/brainstorms
docs/brainstorms/*.zip
docs/brainstorms/*.app

# Local history-rewrite backups (never commit)
.git-backup-*/
wr1.sh
.git-backup2-*/
CHANGELOG.md.bak

# fuzz build artifacts (cargo-fuzz's own target dir; excluded from
# the workspace build by the root Cargo.toml's `exclude = ["fuzz"]`,
# but git still sees it).
/fuzz/target/

# --- fuzz (cargo-fuzz) ---
# libFuzzer's evolving corpus: regenerated on every `cargo fuzz run`
# and by `cargo fuzz tmin`; enormous, machine-local, never checked in.
# The libFuzzer-generated corpus is machine-local and huge. But the
# hand-written seeds for the SSE target — the ones we checked in to
# give the fuzzer a head start (see the seed commit for the reasoning)
# — are tracked. They use a `NN_name` prefix; everything else stays
# ignored.
fuzz/corpus/*
!fuzz/corpus/sse/
fuzz/corpus/sse/*
!fuzz/corpus/sse/[0-9][0-9]_*
!fuzz/corpus/html/
fuzz/corpus/html/*
!fuzz/corpus/html/[0-9][0-9]_*
# Crash/minimization artifacts: belong in the bug report or a test.
fuzz/artifacts/
# libFuzzer's build state (already excluded by the workspace
# `exclude = ["fuzz"]`, but ignore defensively).
fuzz/target/
# --- end fuzz ---

# Snapshot drift debug artifacts
# `characterization_prompts` writes a `.actual.txt` next to
# the expected snapshot when a comparison fails. It is a
# debugging aid, not a source artifact.
*.actual.txt

# .wr.sh write-script backups
*.wr-bak.*
